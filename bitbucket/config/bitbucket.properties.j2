# Generated by /entrypoint.py; set ATL_FORCE_CFG_UPDATE=true to regenerate on every start.
# Reference: https://confluence.atlassian.com/bitbucketserver/bitbucket-server-config-properties-776640155.html
server.port={{ SERVER_PORT | default('7990') }}
server.context-path={{ SERVER_CONTEXT_PATH | default('/') }}
{% if SERVER_PROXY_NAME %}
server.proxy-name={{ SERVER_PROXY_NAME }}
server.proxy-port={{ SERVER_PROXY_PORT | default('443') }}
server.scheme={{ SERVER_SCHEME | default('https') }}
server.secure={{ SERVER_SECURE | default('true') }}
{% endif %}
{% if SETUP_DISPLAYNAME %}
setup.displayName={{ SETUP_DISPLAYNAME }}
setup.baseUrl={{ SETUP_BASEURL }}
setup.license={{ SETUP_LICENSE }}
setup.sysadmin.username={{ SETUP_SYSADMIN_USERNAME }}
setup.sysadmin.password={{ SETUP_SYSADMIN_PASSWORD }}
setup.sysadmin.displayName={{ SETUP_SYSADMIN_DISPLAYNAME | default('Administrator') }}
setup.sysadmin.emailAddress={{ SETUP_SYSADMIN_EMAILADDRESS }}
{% endif %}
{% if JDBC_URL %}
jdbc.driver={{ JDBC_DRIVER }}
jdbc.url={{ JDBC_URL }}
jdbc.user={{ JDBC_USER }}
jdbc.password={{ JDBC_PASSWORD }}
{% endif %}
{% if HAZELCAST_NETWORK_KUBERNETES | default('false') | bool %}
hazelcast.network.kubernetes=true
hazelcast.network.kubernetes.service.name={{ HAZELCAST_KUBERNETES_SERVICE_NAME }}
hazelcast.network.kubernetes.namespace={{ HAZELCAST_KUBERNETES_NAMESPACE }}
hazelcast.group.name={{ HAZELCAST_GROUP_NAME | default('bitbucket') }}
hazelcast.group.password={{ HAZELCAST_GROUP_PASSWORD | default('bitbucket') }}
{% endif %}
{% if PLUGIN_SEARCH_CONFIG_BASEURL %}
plugin.search.config.baseurl={{ PLUGIN_SEARCH_CONFIG_BASEURL }}
plugin.search.config.username={{ PLUGIN_SEARCH_CONFIG_USERNAME }}
plugin.search.config.password={{ PLUGIN_SEARCH_CONFIG_PASSWORD }}
{% endif %}
{% if PLUGIN_SSH_BASEURL %}
plugin.ssh.baseurl={{ PLUGIN_SSH_BASEURL }}
{% endif %}
{% if PLUGIN_SSH_PORT %}
plugin.ssh.port={{ PLUGIN_SSH_PORT }}
{% endif %}
{% if ATL_BITBUCKET_PROPERTIES %}
{{ ATL_BITBUCKET_PROPERTIES }}
{% endif %}
