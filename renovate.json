{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Pins every base digest and Atlassian version; opens a merge request per bump. Runs from the self-hosted Renovate CronJob in k8s/renovate/.",
  "extends": [
    "config:recommended",
    ":pinDigestsExceptForDevDependencies",
    "docker:pinDigests",
    ":separateMajorReleases",
    ":semanticCommits"
  ],
  "timezone": "UTC",
  "schedule": ["at any time"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "labels": ["renovate", "image-hygiene"],
  "dockerfile": {
    "enabled": true,
    "pinDigests": true,
    "managerFilePatterns": ["/(^|/)Dockerfile$/"]
  },
  "customDatasources": {
    "atlassian": {
      "description": "Atlassian Marketplace product versions (Data Center hosting)",
      "defaultRegistryUrlTemplate": "https://marketplace.atlassian.com/rest/2/products/key/{{packageName}}/versions?hosting=datacenter&limit=50&offset=0",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": $map(_embedded.versions, function($v) { { \"version\": $v.name, \"releaseTimestamp\": $v.release.date } }) }"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "jira/VERSION -> Jira Software Data Center",
      "managerFilePatterns": ["/^jira/VERSION$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      "datasourceTemplate": "custom.atlassian",
      "depNameTemplate": "jira-software",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "confluence/VERSION -> Confluence Data Center",
      "managerFilePatterns": ["/^confluence/VERSION$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      "datasourceTemplate": "custom.atlassian",
      "depNameTemplate": "confluence",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "bitbucket/VERSION -> Bitbucket Data Center",
      "managerFilePatterns": ["/^bitbucket/VERSION$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      "datasourceTemplate": "custom.atlassian",
      "depNameTemplate": "bitbucket",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "ARG <TOOL>_VERSION lines annotated with `# renovate: datasource=... depName=...`",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s*\\nARG\\s+\\w+_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Atlassian version bumps: stay on the pinned line; a new feature/LTS line is a deliberate change (edit allowedVersions + support-windows.yaml)",
      "matchDatasources": ["custom.atlassian"],
      "matchDepNames": ["jira-software"],
      "allowedVersions": "/^11\\.3\\./",
      "postUpgradeTasks": {
        "commands": ["scripts/pin-version.sh jira {{{newVersion}}}"],
        "fileFilters": ["jira/VERSION", "jira/SHA256", "jira/Dockerfile"],
        "executionMode": "update"
      },
      "commitMessageTopic": "Jira",
      "labels": ["renovate", "atlassian-release"]
    },
    {
      "matchDatasources": ["custom.atlassian"],
      "matchDepNames": ["confluence"],
      "allowedVersions": "/^9\\.2\\./",
      "postUpgradeTasks": {
        "commands": ["scripts/pin-version.sh confluence {{{newVersion}}}"],
        "fileFilters": ["confluence/VERSION", "confluence/SHA256", "confluence/Dockerfile"],
        "executionMode": "update"
      },
      "commitMessageTopic": "Confluence",
      "labels": ["renovate", "atlassian-release"]
    },
    {
      "matchDatasources": ["custom.atlassian"],
      "matchDepNames": ["bitbucket"],
      "allowedVersions": "/^9\\.4\\./",
      "postUpgradeTasks": {
        "commands": ["scripts/pin-version.sh bitbucket {{{newVersion}}}"],
        "fileFilters": ["bitbucket/VERSION", "bitbucket/SHA256", "bitbucket/Dockerfile"],
        "executionMode": "update"
      },
      "commitMessageTopic": "Bitbucket",
      "labels": ["renovate", "atlassian-release"]
    },
    {
      "description": "Base image digest bumps merge automatically once the pipeline (build, gate, sign) is green; that is the weekly rebuild trigger",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/ubi9/ubi-minimal$/"],
      "matchUpdateTypes": ["digest", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "labels": ["renovate", "base-image"],
      "commitMessageTopic": "UBI 9 minimal base"
    },
    {
      "description": "A new UBI major is a deliberate migration (Trivy needs vuln data for it first)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/ubi9/ubi-minimal$/"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": true,
      "automerge": false
    },
    {
      "description": "Tool bumps in ci-tools and the buildkitd/renovate manifests",
      "matchFileNames": ["ci-tools/Dockerfile", "k8s/**"],
      "groupName": "ci tooling",
      "automerge": false
    }
  ],
  "kubernetes": {
    "managerFilePatterns": ["/^k8s/.+\\.ya?ml$/"]
  },
  "hostRules": [
    {
      "description": "Artifactory: token comes from the Renovate CronJob secret (RENOVATE_HOST_RULES or env)",
      "matchHost": "artifactory.example.com",
      "hostType": "docker"
    }
  ]
}
