{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Pins every base digest, Atlassian version and manifest resource; opens a merge request per bump. Runs from the self-hosted Renovate CronJob in k8s/renovate/.",
  "extends": [
    "config:recommended",
    ":pinDigestsExceptForDevDependencies",
    "docker:pinDigests",
    ":separateMajorReleases",
    ":semanticCommits"
  ],
  "timezone": "UTC",
  "schedule": [
    "at any time"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "labels": [
    "renovate",
    "image-hygiene"
  ],
  "dockerfile": {
    "enabled": true,
    "pinDigests": true,
    "managerFilePatterns": [
      "/(^|/)Dockerfile$/"
    ]
  },
  "customDatasources": {
    "atlassian": {
      "description": "Atlassian Marketplace product versions (Data Center hosting)",
      "defaultRegistryUrlTemplate": "https://marketplace.atlassian.com/rest/2/products/key/{{packageName}}/versions?hosting=datacenter&limit=50&offset=0",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": $map(_embedded.versions, function($v) { { \"version\": $v.name, \"releaseTimestamp\": $v.release.date } }) }"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "jira/<lts|latest>/hardening_manifest.yaml args.VERSION -> Atlassian Marketplace",
      "managerFilePatterns": [
        "/^jira/(lts|latest)/hardening_manifest\\.yaml$/"
      ],
      "matchStrings": [
        "\\n  VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "custom.atlassian",
      "depNameTemplate": "jira-software",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "confluence/<lts|latest>/hardening_manifest.yaml args.VERSION -> Atlassian Marketplace",
      "managerFilePatterns": [
        "/^confluence/(lts|latest)/hardening_manifest\\.yaml$/"
      ],
      "matchStrings": [
        "\\n  VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "custom.atlassian",
      "depNameTemplate": "confluence",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "bitbucket/<lts|latest>/hardening_manifest.yaml args.VERSION -> Atlassian Marketplace",
      "managerFilePatterns": [
        "/^bitbucket/(lts|latest)/hardening_manifest\\.yaml$/"
      ],
      "matchStrings": [
        "\\n  VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "custom.atlassian",
      "depNameTemplate": "bitbucket",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Manifest resources annotated with `# renovate: datasource=... depName=...` (tini, git, copa, crane): the version inside the URL",
      "managerFilePatterns": [
        "/(^|/)hardening_manifest\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)[\\s\\S]*?url:\\s*\\S+?/v?(?<currentValue>\\d+\\.\\d+\\.\\d+)/[^\\n]*"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "git source tarball in bitbucket/<line>/hardening_manifest.yaml (version is in the filename, not a path segment)",
      "managerFilePatterns": [
        "/^bitbucket/(lts|latest)/hardening_manifest\\.yaml$/"
      ],
      "matchStrings": [
        "url:\\s*https://mirrors\\.edge\\.kernel\\.org/pub/software/scm/git/git-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.tar\\.xz"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "git/git",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "ARG <TOOL>_VERSION lines annotated with `# renovate: datasource=... depName=...`",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s*\\nARG\\s+\\w+_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Atlassian bumps: pin-version.sh (re)pins the tarball checksum in the same MR; {{packageFileDir}} is <product>/<line>",
      "matchDatasources": [
        "custom.atlassian"
      ],
      "postUpgradeTasks": {
        "commands": [
          "scripts/pin-version.sh {{{packageFileDir}}} {{{newVersion}}}"
        ],
        "fileFilters": [
          "**/hardening_manifest.yaml"
        ],
        "executionMode": "update"
      },
      "labels": [
        "renovate",
        "atlassian-release"
      ]
    },
    {
      "description": "LTS lines follow patch releases of their pinned line only; a new LTS line is a deliberate change (edit allowedVersions + support-windows.yaml, then re-pin <product>/lts)",
      "matchDatasources": [
        "custom.atlassian"
      ],
      "matchFileNames": [
        "jira/lts/**"
      ],
      "allowedVersions": "/^11\\.3\\./",
      "commitMessageTopic": "Jira LTS"
    },
    {
      "matchDatasources": [
        "custom.atlassian"
      ],
      "matchFileNames": [
        "confluence/lts/**"
      ],
      "allowedVersions": "/^9\\.2\\./",
      "commitMessageTopic": "Confluence LTS"
    },
    {
      "matchDatasources": [
        "custom.atlassian"
      ],
      "matchFileNames": [
        "bitbucket/lts/**"
      ],
      "allowedVersions": "/^9\\.4\\./",
      "commitMessageTopic": "Bitbucket LTS"
    },
    {
      "description": "latest lines follow every feature and patch release of the current major; a major bump (new Java, new base assumptions) is a deliberate change",
      "matchDatasources": [
        "custom.atlassian"
      ],
      "matchFileNames": [
        "jira/latest/**"
      ],
      "allowedVersions": "/^11\\./",
      "commitMessageTopic": "Jira latest"
    },
    {
      "matchDatasources": [
        "custom.atlassian"
      ],
      "matchFileNames": [
        "confluence/latest/**"
      ],
      "allowedVersions": "/^10\\./",
      "commitMessageTopic": "Confluence latest"
    },
    {
      "matchDatasources": [
        "custom.atlassian"
      ],
      "matchFileNames": [
        "bitbucket/latest/**"
      ],
      "allowedVersions": "/^10\\./",
      "commitMessageTopic": "Bitbucket latest"
    },
    {
      "description": "Resource bumps (tini, git, copa, crane): Renovate rewrites the URL, then pin-resource.sh downloads through Artifactory and stores the new sha256 in the same MR",
      "matchDatasources": [
        "github-releases",
        "github-tags"
      ],
      "matchFileNames": [
        "**/hardening_manifest.yaml"
      ],
      "postUpgradeTasks": {
        "commands": [
          "scripts/pin-resource.sh {{{packageFileDir}}} --all"
        ],
        "fileFilters": [
          "**/hardening_manifest.yaml"
        ],
        "executionMode": "update"
      },
      "labels": [
        "renovate",
        "resource"
      ],
      "automerge": false
    },
    {
      "description": "Base image digest bumps merge automatically once the pipeline (build, gate, sign) is green; that is the weekly rebuild trigger",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/ubi9/ubi-minimal$/"
      ],
      "matchUpdateTypes": [
        "digest",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "labels": [
        "renovate",
        "base-image"
      ],
      "commitMessageTopic": "UBI 9 minimal base"
    },
    {
      "description": "A new UBI major is a deliberate migration (Trivy needs vuln data for it first)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/ubi9/ubi-minimal$/"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": true,
      "automerge": false
    },
    {
      "description": "Tool bumps in ci-tools and the buildkitd/renovate manifests",
      "matchFileNames": [
        "ci-tools/Dockerfile",
        "k8s/**"
      ],
      "groupName": "ci tooling",
      "automerge": false
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^k8s/.+\\.ya?ml$/"
    ]
  },
  "hostRules": [
    {
      "description": "Artifactory: token comes from the Renovate CronJob secret (RENOVATE_HOST_RULES or env)",
      "matchHost": "artifactory.example.com",
      "hostType": "docker"
    }
  ]
}
