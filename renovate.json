{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Pins base digests and manifest resources (tini, git, copa, crane) and opens a merge request per bump. Product versions are NOT managed here: scripts/sync-ironbank.sh pulls them from each line's Iron Bank upstream project. Runs from the self-hosted Renovate CronJob in k8s/renovate/.",
  "extends": [
    "config:recommended",
    ":pinDigestsExceptForDevDependencies",
    "docker:pinDigests",
    ":separateMajorReleases",
    ":semanticCommits"
  ],
  "timezone": "UTC",
  "schedule": [
    "at any time"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "labels": [
    "renovate",
    "image-hygiene"
  ],
  "dockerfile": {
    "enabled": true,
    "pinDigests": true,
    "managerFilePatterns": [
      "/(^|/)Dockerfile$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Manifest resources annotated with `# renovate: datasource=... depName=...` (tini, git, copa, crane): the version inside the URL",
      "managerFilePatterns": [
        "/(^|/)hardening_manifest\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)[\\s\\S]*?url:\\s*\\S+?/v?(?<currentValue>\\d+\\.\\d+\\.\\d+)/[^\\n]*"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "git source tarball in bitbucket/lts/hardening_manifest.yaml (version is in the filename, not a path segment)",
      "managerFilePatterns": [
        "/^bitbucket/lts/hardening_manifest\\.yaml$/"
      ],
      "matchStrings": [
        "url:\\s*https://mirrors\\.edge\\.kernel\\.org/pub/software/scm/git/git-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.tar\\.xz"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "git/git",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "ARG <TOOL>_VERSION lines annotated with `# renovate: datasource=... depName=...`",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s*\\nARG\\s+\\w+_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Resource bumps (tini, git, copa, crane): Renovate rewrites the URL, then pin-resource.sh downloads through Artifactory and stores the new sha256 in the same MR",
      "matchDatasources": [
        "github-releases",
        "github-tags"
      ],
      "matchFileNames": [
        "**/hardening_manifest.yaml"
      ],
      "postUpgradeTasks": {
        "commands": [
          "scripts/pin-resource.sh {{{packageFileDir}}} --all"
        ],
        "fileFilters": [
          "**/hardening_manifest.yaml"
        ],
        "executionMode": "update"
      },
      "labels": [
        "renovate",
        "resource"
      ],
      "automerge": false
    },
    {
      "description": "Base image digest bumps merge automatically once the pipeline (build, gate, sign) is green; that is the weekly rebuild trigger",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/ubi9/ubi-minimal$/"
      ],
      "matchUpdateTypes": [
        "digest",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "labels": [
        "renovate",
        "base-image"
      ],
      "commitMessageTopic": "UBI 9 minimal base"
    },
    {
      "description": "A new UBI major is a deliberate migration (Trivy needs vuln data for it first)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/ubi9/ubi-minimal$/"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": true,
      "automerge": false
    },
    {
      "description": "Tool bumps in ci-tools and the buildkitd/renovate manifests",
      "matchFileNames": [
        "ci-tools/Dockerfile",
        "k8s/**"
      ],
      "groupName": "ci tooling",
      "automerge": false
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^k8s/.+\\.ya?ml$/"
    ]
  },
  "hostRules": [
    {
      "description": "Artifactory: token comes from the Renovate CronJob secret (RENOVATE_HOST_RULES or env)",
      "matchHost": "artifactory.example.com",
      "hostType": "docker"
    }
  ]
}
